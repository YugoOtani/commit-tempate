{
  "change": {
    "id": "emfrp-user-replay",
    "title": "最後に与えた時変値を自動で記録・再生する",
    "request": "最後に与えた時変値を保存し、次回のデバッグ実行で再利用できるようにする",
    "baseRevision": "3ab8547^",
    "targetRevision": "3ab8547"
  },

  "overview": {
    "summary": "デバッグ実行中の入力履歴を保存し、user-replayモードでは保存済み入力を既存のInputInterface経路から再生できるようにする。",
    "implementation": [
      "入力履歴を保存・再生できる仕組みを追加する",
      "user-replayをVS CodeからPythonまで伝播する",
      "保存済み入力をDebuggerの既存入力経路へ接続する",
      "Replay開始失敗をVS Codeまで伝播する",
      "Replay入力も既存のtimeline表示で扱う"
    ]
  },

  "nodes": [
    {
      "id": "saved-input-mechanism",
      "title": "保存済み入力を再利用できる仕組みを作る",
      "description": "保存済み入力履歴をInputInterfaceとして順次供給できるSavedInputTraceIterを追加する。",
      "sourceRegionId": "region-saved-input-iterator"
    },
    {
      "id": "load-saved-trace",
      "title": "保存済みtraceを入力履歴へ復元する",
      "description": "trace.txtを読み込み、program IDと各node=valueレコードを検証して内部バッファへ復元する。",
      "rationale": "Replay専用の実行ループを作らず、既存のInputInterface経路を再利用するため。",
      "watch": [
        "traceファイルが存在しない場合はFailure",
        "program IDが一致しない場合はFailure",
        "壊れたレコードもFailure"
      ],
      "sourceRegionId": "region-load-saved-trace"
    },
    {
      "id": "provide-replayed-input",
      "title": "復元済み入力をiteration単位で供給する",
      "description": "SavedInputTraceIterの内部バッファから次の入力集合を順番に返す。",
      "sourceRegionId": "region-next-replayed-input"
    },
    {
      "id": "save-input-trace",
      "title": "現在の入力履歴をtrace.txtへ保存する",
      "description": "program IDを先頭行に書き、各iterationの入力をnode=value形式で保存する。",
      "watch": [
        "書き込み失敗は例外として上位へ伝播せずログへ出す"
      ],
      "sourceRegionId": "region-save-trace"
    },
    {
      "id": "save-on-abort",
      "title": "デバッグ終了時に入力履歴を保存する",
      "description": "Debuggerのabort処理を入力履歴の保存タイミングとして利用する。",
      "sourceRegionId": "region-save-on-abort"
    },
    {
      "id": "connect-replay-to-debugger",
      "title": "保存済み入力をDebuggerの入力経路へ接続する",
      "description": "SavedInputTraceIterの読み込みに成功したら、通常のInputInterfaceとしてregister_input_interface()へ渡す。",
      "rationale": "user-inputとuser-replayで実行ループを分けず、入力源だけを差し替えるため。",
      "sourceRegionId": "region-load-input-interface"
    },

    {
      "id": "select-user-replay",
      "title": "UIからUser Replay Modeを選択できるようにする",
      "description": "executionMode未指定時のQuickPickへUser Replay Modeを追加する。",
      "sourceRegionId": "region-replay-quickpick"
    },
    {
      "id": "allow-replay-in-debug-config",
      "title": "debug configurationでuser-replayを指定できるようにする",
      "description": "executionModeのschemaへuser-replayを追加する。",
      "sourceRegionId": "region-debug-config-replay"
    },
    {
      "id": "represent-replay-mode-ts",
      "title": "TypeScriptでuser-replayを実行モードとして表現する",
      "description": "ExecutionMode型へuser-replayを追加する。",
      "sourceRegionId": "region-ts-execution-mode"
    },
    {
      "id": "accept-replay-mode-python",
      "title": "Python側でuser-replayを受理する",
      "description": "start requestのexecutionMode Literalへuser-replayを追加する。",
      "sourceRegionId": "region-python-execution-mode"
    },
    {
      "id": "start-user-replay",
      "title": "user-replay起動時に保存済み入力をロードする",
      "description": "start requestがuser-replayならDebuggerのload_input_interface()を呼ぶ。",
      "sourceRegionId": "region-start-user-replay"
    },

    {
      "id": "return-replay-start-failure",
      "title": "Replay開始失敗をcommandFailとして返す",
      "description": "保存済み入力を利用できない場合、通常起動を続けずcommandFail responseへ変換する。",
      "sourceRegionId": "region-start-user-replay"
    },
    {
      "id": "propagate-command-fail",
      "title": "PythonのcommandFailをengineの失敗結果として伝播する",
      "description": "正常なstart responseと失敗時のmessageを区別してadapterへ返す。",
      "sourceRegionId": "region-engine-start-failure"
    },
    {
      "id": "show-start-error",
      "title": "Replay開始失敗をVS Codeへ表示する",
      "description": "engineの失敗結果をDAP error responseとVS Code通知としてユーザーへ表示する。",
      "sourceRegionId": "region-show-start-error"
    },

    {
      "id": "centralize-input-active-state",
      "title": "入力interfaceのactive判定をDebuggerへ集約する",
      "description": "session固有の入力状態ではなくDebugger側の登録状態を参照する。",
      "sourceRegionId": "region-input-active"
    },
    {
      "id": "show-replay-timeline",
      "title": "user-replayでも入力timelineを表示する",
      "description": "user-inputと同じtimeline取得経路へuser-replayを含める。",
      "sourceRegionId": "region-replay-timeline"
    }
  ],

